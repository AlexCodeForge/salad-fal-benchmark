# fal.ai (M1 live, M5+)
FAL_KEY=

# Replay fixtures directory (default: fixtures/<fixture>/fal_replay)
FAL_REPLAY_DIR=

# Salad Cloud (M4 deploy, M5 inference)
SALAD_API_KEY=
SALAD_ORGANIZATION_NAME=
SALAD_PROJECT_NAME=
SALAD_ANALYZE_GATEWAY_URL=
SALAD_GATEWAY_URL=

# Legacy dual-gateway mode (optional — used when SALAD_SAM3_GATEWAY_URL is set)
SALAD_SAM3_GATEWAY_URL=
SALAD_DEPTH_GATEWAY_URL=

# Optional Salad deploy tuning
SALAD_GPU_PRIORITY=

# Benchmark paths (optional overrides)
BENCH_FIXTURES_DIR=
BENCH_OUTPUT_DIR=

# HTTP client timeout for gateway calls (default: 120)
BENCH_HTTP_TIMEOUT_S=

# Private Docker registry (M4, if not using public images)
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
DOCKER_REGISTRY_URL=
